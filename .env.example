# Timezone (must be Asia/Singapore)
TIMEZONE=Asia/Singapore

# Database MySQL connection (individual fields — assembled into mysql://user:password@host:port/db)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=expense_user
MYSQL_PASSWORD=expense_password
MYSQL_DATABASE=expense_tracker

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Gmail IMAP credentials (use App Password, not regular password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# Polling interval in seconds
POLL_INTERVAL_SECONDS=60

# In-process HTTP health server port (probed by Docker healthcheck)
HEALTH_PORT=8080

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# LLM (used to auto-categorize transactions). Leave empty to disable.
# Any OpenAI-compatible endpoint works. Tested with OpenRouter.
LLM_BASE_URL=https://api.openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.7

# Config store (sibling service). The expense_tracker polls the
# (project=expense_tracker, key=tags) entry here for the list of
# allowed tags. Falls back to a hard-coded list when unreachable.
# On the docker network the service is reachable as http://config_store:6002.
CONFIG_STORE_URL=http://config_store:6002
CONFIG_STORE_PROJECT=expense_tracker
CONFIG_STORE_TAGS_KEY=tags
# Config_store key for the subset of tags that should NOT be offered
# to the LLM tagger (these tags still drive /tag validation and
# breakdown rendering). Missing/invalid → no exclusions.
CONFIG_STORE_TAGS_EXCLUDED_KEY=tags_excluded_from_llm
CONFIG_STORE_POLL_SECONDS=60
